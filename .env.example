# Optional overrides. Defaults are already safe for a local-only deployment.
HERMES_A2A_ENDPOINT=http://127.0.0.1:9900
# HERMES_A2A_TOKEN=
# CODEX_A2A_GATEWAY_STATE_PATH=/absolute/path/to/private/state.sqlite3
CODEX_A2A_GATEWAY_DEFAULT_TIMEOUT=60
CODEX_A2A_GATEWAY_AUTO_WAIT=15
CODEX_A2A_GATEWAY_SYNC_WAIT=30
CODEX_A2A_GATEWAY_CORRELATION_TIMEOUT=300
CODEX_A2A_GATEWAY_MAX_MESSAGE_CHARS=32768
CODEX_A2A_GATEWAY_MAX_TURNS=5
CODEX_A2A_GATEWAY_MAX_CONCURRENCY=4

# Inbound A2A -> Codex gateway. Loopback is the safe default.
CODEX_A2A_HOST=127.0.0.1
CODEX_A2A_PORT=9910
# CODEX_A2A_PUBLIC_URL=http://127.0.0.1:9910
# CODEX_A2A_BEARER_TOKEN=generate-a-long-random-token
CODEX_A2A_AGENT_NAME="Codex A2A Gateway"
CODEX_A2A_MAX_REQUEST_BYTES=1048576
CODEX_A2A_MAX_PENDING_TASKS=16

# Codex App Server stdio is the default integration path.
CODEX_A2A_GATEWAY_BACKEND=app-server
# Explicit compatibility fallback. When true, a new context may fall back to
# `codex exec --json` only if App Server failed before creating a thread.
CODEX_A2A_GATEWAY_CLI_FALLBACK=false
CODEX_CLI_BIN=codex
CODEX_WORKSPACE_ROOT=/absolute/path/to/workspace
CODEX_A2A_GATEWAY_CODEX_TIMEOUT=300
CODEX_A2A_GATEWAY_APPROVAL_POLICY=never
# Receiver policy for the opt-in inbound execution-preferences extension.
# Empty allowed-models means no additional restriction beyond App Server model/list.
# CODEX_A2A_GATEWAY_ALLOWED_MODELS=gpt-5.6-terra,gpt-5.6-sol
# CODEX_A2A_GATEWAY_DEFAULT_MODEL=gpt-5.6-terra
# CODEX_A2A_GATEWAY_ALLOWED_REASONING_EFFORTS=low,medium,high
# CODEX_A2A_GATEWAY_DEFAULT_REASONING_EFFORT=medium

# Deployment: Codex, Hermes and A2A run on one execution host; Desktop uses Codex Remote.
# Worker tools come from that host's configuration, not from Desktop plugins.
# CODEX_A2A_GATEWAY_WORKER_TASK_ID is set internally on worker subprocesses to prevent delegation loops.
# Do not set it for the everyday outbound Codex assistant. See docs/durable-jobs.md.

# Agent-led setup uses these existing environment variables through
# a persistent private launcher. For new both-mode installs, give MCP serve and
# inbound gateway separate state paths/launchers. install-skills stores no secrets.
# doctor --mode inbound does not require Hermes; model execution remains unverified.

# Outbound Hermes continuation compatibility is automatic; no new environment setting.
# Missing ACK/provenance remains outcome_unknown and is never automatically resent.

# v0.6 opt-in broker: separate store, loopback behind a private TLS reverse proxy.
# Set secrets through protected environment injection; placeholders are not usable credentials.
# CODEX_A2A_GATEWAY_BROKER_DATABASE_URL=postgresql:///gateway?host=/var/run/postgresql
# CODEX_A2A_GATEWAY_BROKER_DEVICE_TOKENS={"workstation":"REPLACE_WITH_RANDOM_TOKEN"}
# CODEX_A2A_GATEWAY_BROKER_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# CODEX_A2A_GATEWAY_BROKER_PUBLIC_URL=https://gateway.internal:9443
# CODEX_A2A_GATEWAY_BROKER_HOST=127.0.0.1
# CODEX_A2A_GATEWAY_BROKER_PORT=8790
# CODEX_A2A_GATEWAY_BROKER_PAYLOAD_TTL_SECONDS=86400
# CODEX_A2A_GATEWAY_BROKER_ARTIFACT_TTL_SECONDS=86400
# CODEX_A2A_GATEWAY_BROKER_RESULT_TTL_SECONDS=604800
# CODEX_A2A_GATEWAY_BROKER_EVENT_TTL_SECONDS=604800
# CODEX_A2A_GATEWAY_BROKER_MAX_ARTIFACT_BYTES=10485760
# CODEX_A2A_GATEWAY_BROKER_DEVICE_QUOTA_BYTES=104857600
# CODEX_A2A_GATEWAY_BROKER_MAX_PENDING_PER_DEVICE=100
# Absolute stream lifetime; increase deliberately for long work (max 3600).
# CODEX_A2A_GATEWAY_BROKER_PEER_TIMEOUT_SECONDS=300
# CODEX_A2A_GATEWAY_BROKER_MAX_CONCURRENT_STREAMS=4

# v0.6 client daemon: use a separate private state directory and device credential.
# CODEX_A2A_GATEWAY_CLIENT_BROKER_URL=https://gateway.internal:9443
# CODEX_A2A_GATEWAY_CLIENT_TOKEN=REPLACE_WITH_DEVICE_TOKEN
# CODEX_A2A_GATEWAY_CLIENT_CA_FILE=/absolute/path/to/private-ca.crt
# CODEX_A2A_GATEWAY_CLIENT_STATE_DIR=/absolute/path/to/private/client-state
# CODEX_A2A_GATEWAY_CLIENT_PAYLOAD_KEY=REPLACE_WITH_CLIENT_FERNET_KEY
# CODEX_A2A_GATEWAY_CLIENT_CODEX_COMMAND=/absolute/path/to/codex
# Never enable loopback development HTTP for a remote broker connection.
