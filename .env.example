# Server: loopback Hermes peer, HTTPS PostgreSQL broker. Secrets below are placeholders.
HERMES_A2A_ENDPOINT=http://127.0.0.1:9900
# HERMES_A2A_TOKEN=
# HERMES_A2A_GATEWAY_BROKER_DATABASE_URL=postgresql:///gateway?host=/var/run/postgresql
# HERMES_A2A_GATEWAY_BROKER_DEVICE_TOKENS='{"workstation":"REPLACE_WITH_RANDOM_DEVICE_TOKEN"}'
# HERMES_A2A_GATEWAY_BROKER_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# HERMES_A2A_GATEWAY_BROKER_PUBLIC_URL=https://gateway.internal:9443
# HERMES_A2A_GATEWAY_BROKER_HOST=127.0.0.1
# HERMES_A2A_GATEWAY_BROKER_PORT=8790
# HERMES_A2A_GATEWAY_BROKER_PAYLOAD_TTL_SECONDS=86400
# HERMES_A2A_GATEWAY_BROKER_ARTIFACT_TTL_SECONDS=86400
# HERMES_A2A_GATEWAY_BROKER_RESULT_TTL_SECONDS=604800
# HERMES_A2A_GATEWAY_BROKER_EVENT_TTL_SECONDS=604800
# HERMES_A2A_GATEWAY_BROKER_MAX_ARTIFACT_BYTES=10485760
# HERMES_A2A_GATEWAY_BROKER_DEVICE_QUOTA_BYTES=104857600
# HERMES_A2A_GATEWAY_BROKER_MAX_PENDING_PER_DEVICE=100
# HERMES_A2A_GATEWAY_BROKER_PEER_TIMEOUT_SECONDS=300
# HERMES_A2A_GATEWAY_BROKER_MAX_CONCURRENT_STREAMS=4

# Client: one private inbox and one credential per device.
# HERMES_A2A_GATEWAY_CLIENT_TRANSPORT_MODE=direct
# HERMES_A2A_GATEWAY_CLIENT_BROKER_URL=https://gateway.internal:9443
# HERMES_A2A_GATEWAY_CLIENT_TOKEN=REPLACE_WITH_DEVICE_TOKEN
# HERMES_A2A_GATEWAY_CLIENT_CA_FILE=/absolute/path/to/private-ca.crt
# HERMES_A2A_GATEWAY_CLIENT_STATE_DIR=/absolute/path/to/private/client-state
# HERMES_A2A_GATEWAY_CLIENT_PAYLOAD_KEY=REPLACE_WITH_CLIENT_FERNET_KEY
# HERMES_A2A_GATEWAY_CLIENT_CODEX_COMMAND=/absolute/path/to/codex
# Default wait only: explicit gateway_submit.wait_seconds accepts 0..60.
# HERMES_A2A_GATEWAY_CLIENT_INLINE_WAIT_SECONDS=15
# HERMES_A2A_GATEWAY_CLIENT_REQUEST_TIMEOUT_SECONDS=20
# HERMES_A2A_GATEWAY_CLIENT_NATIVE_DELIVERY=true

# Optional daemon-managed SSH tunnel. Keep HTTPS and bearer authentication.
# HERMES_A2A_GATEWAY_CLIENT_TRANSPORT_MODE=ssh-tunnel
# HERMES_A2A_GATEWAY_CLIENT_BROKER_URL=https://127.0.0.1:18790
# HERMES_A2A_GATEWAY_CLIENT_SSH_HOST=my-server-alias
# HERMES_A2A_GATEWAY_CLIENT_SSH_LOCAL_PORT=18790
# Destination as reached FROM the SSH server; use the actual TLS proxy bind.
# HERMES_A2A_GATEWAY_CLIENT_SSH_REMOTE_HOST=127.0.0.1
# HERMES_A2A_GATEWAY_CLIENT_SSH_REMOTE_PORT=9443
# Optional overrides; omit to reuse ~/.ssh/config and SSH agent/key setup.
# HERMES_A2A_GATEWAY_CLIENT_SSH_USER=operator
# HERMES_A2A_GATEWAY_CLIENT_SSH_PORT=22
# HERMES_A2A_GATEWAY_CLIENT_SSH_IDENTITY_FILE=/absolute/path/to/ssh-key
# HERMES_A2A_GATEWAY_CLIENT_SSH_COMMAND=/usr/bin/ssh
# HERMES_A2A_GATEWAY_CLIENT_SSH_CONNECT_TIMEOUT_SECONDS=10
# If the TLS certificate names the original broker instead of 127.0.0.1:
# HERMES_A2A_GATEWAY_CLIENT_SSH_TLS_SERVER_NAME=gateway.internal
# Never disable TLS verification or auto-accept a changed SSH host key.
