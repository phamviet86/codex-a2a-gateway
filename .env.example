# Optional overrides. Defaults are already safe for a local-only deployment.
HERMES_A2A_ENDPOINT=http://127.0.0.1:9900
# HERMES_A2A_TOKEN=
# CODEX_A2A_GATEWAY_STATE_PATH=/absolute/path/to/private/state.sqlite3
CODEX_A2A_GATEWAY_DEFAULT_TIMEOUT=60
CODEX_A2A_GATEWAY_AUTO_WAIT=15
CODEX_A2A_GATEWAY_SYNC_WAIT=30
CODEX_A2A_GATEWAY_CORRELATION_TIMEOUT=300
CODEX_A2A_GATEWAY_MAX_MESSAGE_CHARS=32768
CODEX_A2A_GATEWAY_MAX_TURNS=5
CODEX_A2A_GATEWAY_MAX_CONCURRENCY=4

# Inbound A2A -> Codex gateway. Loopback is the safe default.
CODEX_A2A_HOST=127.0.0.1
CODEX_A2A_PORT=9910
# CODEX_A2A_PUBLIC_URL=http://127.0.0.1:9910
# CODEX_A2A_BEARER_TOKEN=generate-a-long-random-token
CODEX_A2A_AGENT_NAME="Codex A2A Gateway"
CODEX_A2A_MAX_REQUEST_BYTES=1048576
CODEX_A2A_MAX_PENDING_TASKS=16

# Codex App Server stdio is the default integration path.
CODEX_A2A_GATEWAY_BACKEND=app-server
# Explicit compatibility fallback. When true, a new context may fall back to
# `codex exec --json` only if App Server failed before creating a thread.
CODEX_A2A_GATEWAY_CLI_FALLBACK=false
CODEX_CLI_BIN=codex
CODEX_WORKSPACE_ROOT=/absolute/path/to/workspace
CODEX_A2A_GATEWAY_CODEX_TIMEOUT=300
CODEX_A2A_GATEWAY_APPROVAL_POLICY=never
# Receiver policy for the opt-in inbound execution-preferences extension.
# Empty allowed-models means no additional restriction beyond App Server model/list.
# CODEX_A2A_GATEWAY_ALLOWED_MODELS=gpt-5.6-terra,gpt-5.6-sol
# CODEX_A2A_GATEWAY_DEFAULT_MODEL=gpt-5.6-terra
# CODEX_A2A_GATEWAY_ALLOWED_REASONING_EFFORTS=low,medium,high
# CODEX_A2A_GATEWAY_DEFAULT_REASONING_EFFORT=medium

# Deployment: Codex, Hermes and A2A run on one execution host; Desktop uses Codex Remote.
# Worker tools come from that host's configuration, not from Desktop plugins.
# CODEX_A2A_GATEWAY_WORKER_TASK_ID is set internally on worker subprocesses to prevent delegation loops.
# Do not set it for the everyday outbound Codex assistant. See docs/durable-jobs.md.
