# Optional overrides. Defaults are already safe for a local-only deployment.
HERMES_A2A_ENDPOINT=http://127.0.0.1:9900
# HERMES_A2A_TOKEN=
# HERMES_BRIDGE_STATE_PATH=/absolute/path/to/private/state.sqlite3
HERMES_BRIDGE_DEFAULT_TIMEOUT=60
HERMES_BRIDGE_AUTO_WAIT=15
HERMES_BRIDGE_SYNC_WAIT=30
HERMES_BRIDGE_CORRELATION_TIMEOUT=300
HERMES_BRIDGE_MAX_MESSAGE_CHARS=32768
HERMES_BRIDGE_MAX_TURNS=5
HERMES_BRIDGE_MAX_CONCURRENCY=4
